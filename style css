:root {
  --bg: #f5f5f2;
  --card: #ffffff;
  --dark: #111111;
  --dark-2: #1d1d1d;
  --gold: #c9a227;
  --gold-light: #e4c75b;
  --text: #202020;
  --muted: #777;
  --border: #e7e7e2;
  --success: #258a52;
  --danger: #c83b3b;
  --shadow: 0 10px 35px rgba(0,0,0,.07);
  --radius: 18px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--bg);
  color: var(--text);
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

#app {
  min-height: 100vh;
  display: flex;
}

/* SIDEBAR */

.sidebar {
  width: 255px;
  min-height: 100vh;
  background: var(--dark);
  color: white;
  padding: 25px 16px;
  display: flex;
  flex-direction: column;
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 10px 28px;
  border-bottom: 1px solid rgba(255,255,255,.1);
}

.brand-mark {
  width: 48px;
  height: 48px;
  border: 1px solid var(--gold);
  color: var(--gold-light);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  letter-spacing: -2px;
}

.brand h1 {
  font-size: 20px;
  letter-spacing: 2px;
}

.brand span {
  display: block;
  color: #999;
  font-size: 8px;
  letter-spacing: 1.4px;
  margin-top: 4px;
}

.navigation {
  margin-top: 25px;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.nav-item {
  border: 0;
  background: transparent;
  color: #aaa;
  text-align: left;
  padding: 14px 15px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 13px;
  transition: .2s;
}

.nav-item span {
  width: 22px;
  text-align: center;
  font-size: 18px;
}

.nav-item:hover {
  background: #1d1d1d;
  color: white;
}

.nav-item.active {
  background: linear-gradient(135deg, #292929, #181818);
  color: var(--gold-light);
  box-shadow: inset 3px 0 0 var(--gold);
}

.sidebar-bottom {
  margin-top: auto;
  padding: 15px 10px 4px;
  color: #888;
  font-size: 11px;
}

.system-status {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #aaa;
  margin-bottom: 10px;
}

.status-dot {
  width: 8px;
  height: 8px;
  background: #3fc675;
  border-radius: 50%;
  box-shadow: 0 0 10px rgba(63,198,117,.6);
}

/* MAIN */

.main {
  width: calc(100% - 255px);
  margin-left: 255px;
  min-height: 100vh;
}

.topbar {
  height: 82px;
  background: rgba(255,255,255,.95);
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 35px;
  position: sticky;
  top: 0;
  z-index: 50;
}

.page-title span {
  color: #999;
  font-size: 10px;
  letter-spacing: 1px;
}

.page-title h2 {
  font-size: 19px;
  margin-top: 3px;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.clock {
  color: #777;
  font-size: 13px;
  font-weight: 600;
}

.profile {
  border: 0;
  background: transparent;
  display: flex;
  align-items: center;
  gap: 8px;
}

.profile-circle {
  width: 35px;
  height: 35px;
  border-radius: 50%;
  background: var(--dark);
  color: var(--gold-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.profile-name {
  font-size: 11px;
  font-weight: 700;
}

.mobile-menu {
  display: none;
  border: 0;
  background: transparent;
  font-size: 22px;
}

/* CONTENT */

.content {
  padding: 35px;
}

.page {
  display: none;
}

.page.active-page {
  display: block;
}

.welcome {
  background:
    radial-gradient(circle at 90% 20%, rgba(201,162,39,.2), transparent 35%),
    linear-gradient(135deg, #171717, #282828);
  color: white;
  padding: 35px;
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 25px;
  box-shadow: var(--shadow);
}

.eyebrow {
  color: var(--gold);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

.welcome h1 {
  font-size: 36px;
  margin: 8px 0;
  letter-spacing: 1px;
}

.welcome h1 strong {
  color: var(--gold-light);
}

.welcome p {
  color: #aaa;
  font-size: 14px;
}

/* BUTTONS */

.primary-btn {
  border: 0;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  color: #171717;
  padding: 13px 20px;
  font-weight: 800;
  box-shadow: 0 8px 20px rgba(201,162,39,.18);
  transition: .2s;
}

.primary-btn:hover {
  transform: translateY(-2px);
}

.primary-btn.small {
  padding: 10px 16px;
  font-size: 12px;
}

.text-btn {
  background: transparent;
  border: 0;
  color: #8c6d08;
  font-size: 12px;
  font-weight: 700;
}

/* STATS */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 35px;
}

.stat-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 22px;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: var(--shadow);
}

.stat-icon {
  width: 48px;
  height: 48px;
  background: #faf5dc;
  color: #8c6d08;
  border-radius: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19px;
  font-weight: bold;
}

.stat-card span {
  display: block;
  color: #888;
  font-size: 11px;
  margin-bottom: 6px;
}

.stat-card strong {
  font-size: 20px;
}

/* SECTION */

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15px;
}

.section-header h2 {
  font-size: 20px;
  margin-top: 5px;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 35px;
}

.quick-card {
  border: 1px solid var(--border);
  background: white;
  padding: 22px;
  text-align: left;
  border-radius: var(--radius);
  transition: .2s;
  box-shadow: var(--shadow);
}

.quick-card:hover {
  transform: translateY(-3px);
  border-color: var(--gold);
}

.quick-icon {
  display: block;
  color: var(--gold);
  font-size: 25px;
  margin-bottom: 15px;
}

.quick-card strong {
  display: block;
  margin-bottom: 6px;
}

.quick-card small {
  color: #888;
  font-size: 11px;
}

/* TABLE */

.table-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.orders-table-wrapper {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 650px;
}

th {
  background: #fafafa;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-size: 9px;
  padding: 15px 20px;
  text-align: left;
}

td {
  padding: 17px 20px;
  border-top: 1px solid #eee;
  font-size: 12px;
}

.empty-state {
  padding: 55px 20px;
  text-align: center;
}

.empty-icon {
  width: 60px;
  height: 60px;
  border-radius: 18px;
  background: #faf5dc;
  color: #a17c08;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 15px;
  font-size: 25px;
}

.empty-state h3 {
  margin-bottom: 8px;
}

.empty-state p {
  color: #888;
  font-size: 12px;
  margin-bottom: 18px;
}

.orders-table-wrapper {
  display: none;
}

.recent-header {
  margin-bottom: 14px;
}

/* PAGE INTRO */

.page-intro {
  margin-bottom: 28px;
}

.page-intro h1 {
  font-size: 32px;
  margin: 7px 0;
}

.page-intro p {
  color: #777;
  font-size: 13px;
}

/* SALE */

.sale-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(310px, .8fr);
  gap: 20px;
  align-items: start;
}

.sale-menu,
.cart-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.sale-menu {
  padding: 24px;
}

.sale-menu-header,
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
}

.sale-menu-header h2,
.cart-header h2 {
  margin-top: 5px;
  font-size: 20px;
}

#menuSearch {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 11px 13px;
  width: 190px;
  outline: none;
}

#menuSearch:focus,
.customer-input input:focus {
  border-color: var(--gold);
}

.category-buttons {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}

.category {
  background: #f5f5f2;
  border: 1px solid var(--border);
  padding: 9px 13px;
  border-radius: 20px;
  font-size: 11px;
}

.category.active {
  background: var(--dark);
  color: var(--gold-light);
  border-color: var(--dark);
}

.food-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13px;
}

.food-card {
  border: 1px solid var(--border);
  background: white;
  border-radius: 15px;
  padding: 16px;
  text-align: left;
  transition: .2s;
}

.food-card:hover {
  border-color: var(--gold);
  transform: translateY(-2px);
}

.food-emoji {
  font-size: 32px;
  margin-bottom: 10px;
}

.food-card h3 {
  font-size: 13px;
  margin-bottom: 5px;
}

.food-card p {
  color: #888;
  font-size: 10px;
  margin-bottom: 12px;
}

.food-price {
  font-weight: 800;
  color: #8c6d08;
  font-size: 13px;
}

/* CART */

.cart-card {
  padding: 22px;
  position: sticky;
  top: 105px;
}

.clear-btn {
  border: 0;
  background: transparent;
  color: var(--danger);
  font-size: 11px;
  font-weight: 700;
}

.customer-input {
  margin-bottom: 20px;
}

.customer-input label {
  display: block;
  color: #777;
  font-size: 10px;
  margin-bottom: 7px;
}

.customer-input input {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 11px;
  outline: none;
}

.cart-items {
  max-height: 300px;
  overflow-y: auto;
}

.cart-empty {
  text-align: center;
  padding: 30px 10px;
  color: #aaa;
}

.cart-empty span {
  display: block;
  font-size: 30px;
  color: #c9c9c9;
  margin-bottom: 8px;
}

.cart-empty p {
  font-size: 11px;
}

.cart-item {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
  padding: 12px 0;
  border-bottom: 1px solid #eee;
}

.cart-item-name {
  font-size: 12px;
  font-weight: 700;
}

.cart-item-price {
  color: #8c6d08;
  font-size: 11px;
  margin-top: 4px;
}

.qty-controls {
  display: flex;
  align-items: center;
  gap: 7px;
}

.qty-btn {
  width: 25px;
  height: 25px;
  border: 1px solid var(--border);
  background: #fafafa;
  border-radius: 7px;
}

.qty-number {
  font-size: 11px;
  font-weight: 700;
}

.bill {
  border-top: 1px solid #eee;
  margin-top: 15px;
  padding-top: 15px;
}

.bill > div {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
  color: #777;
  font-size: 12px;
}

.bill-total {
  padding-top: 12px;
  border-top: 1px dashed #ddd;
  color: var(--dark) !important;
  font-size: 16px !important;
}

.bill-total strong {
  color: #9b7709;
}

.checkout-btn {
  width: 100%;
  border: 0;
  border-radius: 12px;
  background: var(--dark);
  color: white;
  padding: 14px;
  font-weight: 800;
  margin-top: 8px;
}

.checkout-btn:hover {
  background: #292929;
}

/* MENU MANAGEMENT */

.menu-management-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.management-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
  box-shadow: var(--shadow);
}

.management-card .food-emoji {
  font-size: 35px;
}

.management-card h3 {
  font-size: 15px;
  margin-bottom: 5px;
}

.management-card p {
  color: #888;
  font-size: 11px;
  margin-bottom: 15px;
}

.management-price {
  font-weight: 800;
  color: #987609;
}

/* REPORTS */

.report-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 17px;
  margin-bottom: 25px;
}

.report-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 22px;
  box-shadow: var(--shadow);
}

.report-card span {
  display: block;
  color: #888;
  font-size: 11px;
  margin-bottom: 10px;
}

.report-card strong {
  display: block;
  font-size: 22px;
  margin-bottom: 7px;
}

.report-card small {
  color: #aaa;
}

.report-table {
  padding-bottom: 20px;
}

#reportSummary {
  padding: 0 20px;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 13px 0;
  border-bottom: 1px solid #eee;
  font-size: 12px;
}

/* STATUS */

.status {
  display: inline-block;
  padding: 5px 9px;
  border-radius: 20px;
  background: #e8f7ef;
  color: #258a52;
  font-size: 9px;
  font-weight: 800;
}

/* MODAL */

.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.65);
  z-index: 500;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.modal-overlay.show {
  display: flex;
}

.success-modal {
  background: white;
  border-radius: 24px;
  padding: 35px;
  text-align: center;
  width: min(400px, 100%);
  box-shadow: 0 25px 70px rgba(0,0,0,.3);
}

.success-icon {
  width: 65px;
  height: 65px;
  border-radius: 50%;
  background: #e8f7ef;
  color: var(--success);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  font-weight: bold;
  margin: 0 auto 17px;
}

.success-modal p {
  color: #777;
  font-size: 12px;
  margin: 8px 0 18px;
}

.success-total {
  font-size: 28px;
  font-weight: 900;
  color: #9a770b;
  margin-bottom: 22px;
}

/* TOAST */

.toast {
  position: fixed;
  bottom: 25px;
  right: 25px;
  background: var(--dark);
  color: white;
  padding: 13px 18px;
  border-radius: 10px;
  font-size: 12px;
  transform: translateY(100px);
  opacity: 0;
  transition: .3s;
  z-index: 700;
}

.toast.show {
  transform: translateY(0);
  opacity: 1;
}

/* MOBILE */

@media (max-width: 1100px) {

  .stats-grid,
  .report-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .quick-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .sale-layout {
    grid-template-columns: 1fr;
  }

  .cart-card {
    position: static;
  }

  .menu-management-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 800px) {

  .sidebar {
    transform: translateX(-100%);
    transition: .3s;
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .main {
    width: 100%;
    margin-left: 0;
  }

  .topbar {
    padding: 0 18px;
  }

  .mobile-menu {
    display: inline-block;
    margin-right: 8px;
  }

  .page-title {
    display: inline-block;
  }

  .profile-name {
    display: none;
  }

  .content {
    padding: 20px 15px;
  }

  .welcome {
    padding: 25px;
    align-items: flex-start;
    gap: 20px;
    flex-direction: column;
  }

  .welcome h1 {
    font-size: 28px;
  }

  .stats-grid,
  .quick-grid,
  .report-grid,
  .menu-management-grid {
    grid-template-columns: 1fr;
  }

  .food-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .sale-menu {
    padding: 17px;
  }

  .sale-menu-header {
    align-items: flex-start;
    flex-direction: column;
  }

  #menuSearch {
    width: 100%;
  }

  .top-actions {
    gap: 8px;
  }

  .clock {
    display: none;
  }
}

@media (max-width: 450px) {

  .food-grid {
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  .food-card {
    padding: 12px;
  }

  .food-emoji {
    font-size: 26px;
  }

  .page-intro h1 {
    font-size: 27px;
  }

  .stat-card {
    padding: 17px;
  }

  .welcome {
    border-radius: 18px;
  }
}
